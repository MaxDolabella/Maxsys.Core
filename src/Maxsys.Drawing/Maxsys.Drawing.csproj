<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsMaxsysPackage>true</IsMaxsysPackage>
		<Version>17.0.0</Version>
		<Description>Biblioteca Maxsys para manipulação de imagens via System.Drawing (Windows). (.NET 10)</Description>
		<PackageDescription>Biblioteca Maxsys para manipulação de imagens via System.Drawing (Windows). (.NET 10)</PackageDescription>
		<PackageId>Maxsys.Drawing</PackageId>
		<PackageTags>maxsys;image;drawing;system-drawing</PackageTags>
		<!-- System.Drawing.Common é suportado apenas em Windows no .NET 10. -->
		<NoWarn>$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
		<PackageReference Include="System.Drawing.Common" />
	</ItemGroup>

</Project>
